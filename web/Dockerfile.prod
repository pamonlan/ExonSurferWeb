# Stage 1: Builder
FROM ubuntu:22.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    TZ=Europe/Kiev

WORKDIR /build

# Set timezone and base tools
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone && \
    apt-get update && apt-get install --no-install-recommends -y \
    python3.10 python3.10-dev python3-pip \
    build-essential autoconf libtool pkg-config gcc g++ \
    libssl-dev libxml2-dev libcurl4-openssl-dev \
    libpq-dev git \
    curl ca-certificates && \
    update-alternatives --install /usr/bin/python python /usr/bin/python3.10 1 && \
    update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.10 1 && \
    update-alternatives --install /usr/bin/pip pip /usr/bin/pip3 1 && \
    rm -rf /var/lib/apt/lists/*

# Pre-install numpy and pandas (from binary wheels)
RUN pip install --no-cache-dir numpy==1.24.4 pandas==1.5.3

# Copy and resolve remaining dependencies (exclude numpy and pandas from requirements.txt)
COPY requirements.txt .
RUN pip wheel --no-cache-dir --wheel-dir /wheels -r requirements.txt

# Clone and build ExonSurfer (pinned commit for reproducible builds and cache invalidation)
RUN git clone https://github.com/CrisRu95/ExonSurfer.git && \
    cd ExonSurfer && \
    git checkout 2f7e4d1 && \
    python setup.py bdist_wheel && \
    cp dist/*.whl /wheels/ && \
    cd .. && rm -rf ExonSurfer

# Clone and build pyensembl (uses pyproject.toml, not setup.py)
RUN pip install --no-cache-dir --upgrade pip setuptools wheel && \
    git clone https://github.com/pamonlan/pyensembl.git && \
    cd pyensembl && \
    pip wheel . --no-deps -w dist/ && \
    ls dist/pyensembl-*.whl && \
    rm -f /wheels/pyensembl-*.whl && cp dist/pyensembl-*.whl /wheels/ && \
    cd .. && rm -rf pyensembl


# Stage 2: Final Image
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    TZ=Europe/Kiev \
    HOME=/home/app \
    APP_HOME=/home/app/web \
    PYENSEMBL_CACHE_DIR=/home/app/web/Data \
    EXONSURFER_CACHE_DIR=/home/app/web/Data \
    STATICFILES=/home/app/web/staticfiles \
    MEDIA=/home/app/web/media \
    REDIS_URL='redis://redis:6379/0'

WORKDIR $APP_HOME

# Set timezone and install system dependencies
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone && \
    apt-get update && apt-get install --no-install-recommends -y \
    python3.10 python3.10-dev python3-pip \
    libpq5 libpq-dev \
    libxml2 libcurl4-openssl-dev \
    build-essential git \
    netcat postgresql postgresql-contrib && \
    update-alternatives --install /usr/bin/python python /usr/bin/python3.10 1 && \
    update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.10 1 && \
    update-alternatives --install /usr/bin/pip pip /usr/bin/pip3 1 && \
    rm -rf /var/lib/apt/lists/*

# Create app user and directories
RUN mkdir -p $APP_HOME/Data/logs && \
    mkdir -p $APP_HOME/staticfiles && \
    mkdir -p $APP_HOME/media && \
    useradd -u 1000 -U -d $HOME -s /bin/bash app && \
    chown -R app:app /home/app && \
    chmod -R a+rw /home/app && \
    chown -R app:app $APP_HOME && \
    chmod -R a+rw $MEDIA $STATICFILES

# Copy built wheels and install (pyensembl installed --no-deps to preserve requirements.txt pins)
COPY --from=builder /wheels /wheels
RUN pip install --no-cache-dir --no-index --find-links=/wheels $(ls /wheels/*.whl | grep -v '/pyensembl-') && \
    pip install --no-cache-dir --no-index --no-deps /wheels/pyensembl-*.whl

# Copy source code
COPY . $APP_HOME



# Fix ownership and permissions
# Move entrypoint scripts to root of APP_HOME
RUN cp $APP_HOME/scripts/docker/entrypoint.sh $APP_HOME/entrypoint.sh && \
    cp $APP_HOME/scripts/docker/entrypoint_2.sh $APP_HOME/entrypoint_2.sh && \
    cp $APP_HOME/scripts/web/DownloadWorm.py $APP_HOME/DownloadWorm.py && \
    chmod +x $APP_HOME/entrypoint.sh $APP_HOME/entrypoint_2.sh $APP_HOME/DownloadWorm.py && \
    chown -R nobody:nogroup $APP_HOME

# Install BLAST binary
COPY ./bin/blastn /usr/local/bin/blastn
RUN chmod +x /usr/local/bin/blastn

RUN pip install --no-cache-dir numpy==1.24.4 pandas==1.5.3 && \
    python3 -c "from pyensembl import EnsemblRelease, Genome; import pyensembl; print('pyensembl OK:', pyensembl.__file__)"

# Environment path
ENV PATH="$HOME/.local/bin:$APP_HOME/bin:/usr/local/bin:$PATH"

USER nobody
ENTRYPOINT ["/home/app/web//entrypoint.sh"]
